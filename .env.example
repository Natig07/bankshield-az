# Copy to .env and adjust. Never commit .env.

# SQLite database file for local development. The path is relative to the
# project root, so this stores the file at <project-root>/data/dev.db.
DATABASE_URL="file:./data/dev.db"

# Private evidence storage directory. Must be OUTSIDE public/ and never web-served.
EVIDENCE_STORAGE_DIR="./storage-local"

# Authentication uses opaque random database-backed sessions, so no signing secret
# is required. Administrator bootstrap reads its email/name from environment
# variables, but always prompts for the password with terminal echo disabled.
